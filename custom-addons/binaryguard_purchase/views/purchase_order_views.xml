<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="binaryguard_purchase_order_form"
            model="ir.ui.view">

        <field name="name">purchase.order.binaryguard.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="inside">

                <page string="BinaryGuard">

                    <group>

                        <group>
                            <field name="binaryguard_project"/>
                            <field name="binaryguard_site"/>
                            <field name="binaryguard_client"/>
                        </group>

                        <group>
                            <field name="binaryguard_requested_by"/>
                        </group>

                    </group>

                    <group>
                        <field name="binaryguard_notes"/>
                    </group>

                </page>

            </xpath>

        </field>

    </record>

</odoo>

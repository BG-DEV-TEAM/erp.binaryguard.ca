<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_binaryguard_client_list" model="ir.ui.view">
        <field name="name">binaryguard.client.list</field>
        <field name="model">binaryguard.client</field>
        <field name="arch" type="xml">
            <list string="BinaryGuard Clients">
                <field name="name"/>
                <field name="organization"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_binaryguard_client_form" model="ir.ui.view">
        <field name="name">binaryguard.client.form</field>
        <field name="model">binaryguard.client</field>
        <field name="arch" type="xml">
            <form string="BinaryGuard Client">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="organization"/>
                            <field name="active"/>
                        </group>

                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_binaryguard_clients" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">binaryguard.client</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_binaryguard_root"
        name="BinaryGuard ERP"
        sequence="10"
        groups="base.group_user"
    />

    <menuitem
        id="menu_binaryguard_clients"
        name="Clients"
        parent="menu_binaryguard_root"
        action="action_binaryguard_clients"
        sequence="10"
        groups="base.group_user"
    />
</odoo>

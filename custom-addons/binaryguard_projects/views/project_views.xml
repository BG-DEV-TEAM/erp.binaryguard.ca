<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_project_binaryguard" model="ir.ui.view">
        <field name="name">project.project.binaryguard</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <page string="BinaryGuard">

                    <group>

                        <field name="binaryguard_customer"/>
                        <field name="binaryguard_site"/>
                        <field name="binaryguard_contract"/>
                        <field name="binaryguard_project_manager"/>
                        <field name="binaryguard_start_date"/>
                        <field name="binaryguard_end_date"/>
                        <field name="binaryguard_status"/>

                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>

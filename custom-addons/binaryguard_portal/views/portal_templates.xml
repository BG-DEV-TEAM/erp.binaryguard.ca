<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_binaryguard"
              inherit_id="portal.portal_my_home"
              name="BinaryGuard Portal Dashboard">

        <xpath expr="//div[@id='portal_common_category']"
               position="inside">

            <div class="col-12 mt-4">
                <h3>BinaryGuard Services</h3>
            </div>

            <div class="col-12 col-md-6 col-lg-4 mb-3">
                <a href="/my/binaryguard/assets"
                   class="card text-decoration-none h-100">
                    <div class="card-body">
                        <h5>Assets</h5>
                        <p class="text-muted mb-0">
                            View installed and assigned equipment
                        </p>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-6 col-lg-4 mb-3">
                <a href="/my/binaryguard/contracts"
                   class="card text-decoration-none h-100">
                    <div class="card-body">
                        <h5>Service Contracts</h5>
                        <p class="text-muted mb-0">
                            Review contracts, dates and SLA coverage
                        </p>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-6 col-lg-4 mb-3">
                <a href="/my/binaryguard/tickets"
                   class="card text-decoration-none h-100">
                    <div class="card-body">
                        <h5>Support Tickets</h5>
                        <p class="text-muted mb-0">
                            Review technical-support requests
                        </p>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-6 col-lg-4 mb-3">
                <a href="/my/binaryguard/access-cards"
                   class="card text-decoration-none h-100">
                    <div class="card-body">
                        <h5>Access Cards</h5>
                        <p class="text-muted mb-0">
                            View issued and assigned access cards
                        </p>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-6 col-lg-4 mb-3">
                <a href="/my/binaryguard/maintenance"
                   class="card text-decoration-none h-100">
                    <div class="card-body">
                        <h5>Maintenance Plans</h5>
                        <p class="text-muted mb-0">
                            View preventive-maintenance schedules
                        </p>
                    </div>
                </a>
            </div>

        </xpath>
    </template>

    <template id="portal_binaryguard_assets"
              name="My BinaryGuard Assets">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <h2>My Assets</h2>

                <div class="table-responsive mt-3">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Asset</th>
                                <th>Type</th>
                                <th>Serial Number</th>
                                <th>Location</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="assets" t-as="asset">
                                <td>
                                    <span t-field="asset.asset_name"/>
                                </td>
                                <td>
                                    <span t-field="asset.asset_type"/>
                                </td>
                                <td>
                                    <span t-field="asset.serial_number"/>
                                </td>
                                <td>
                                    <span t-field="asset.site_location"/>
                                </td>
                                <td>
                                    <span t-field="asset.status"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div t-if="not assets"
                     class="alert alert-info">
                    No assets are currently available.
                </div>
            </div>
        </t>
    </template>

    <template id="portal_binaryguard_contracts"
              name="My BinaryGuard Contracts">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <h2>My Service Contracts</h2>

                <div class="table-responsive mt-3">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Contract</th>
                                <th>Type</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="contracts" t-as="contract">
                                <td>
                                    <span t-field="contract.contract_title"/>
                                </td>
                                <td>
                                    <span t-field="contract.contract_type"/>
                                </td>
                                <td>
                                    <span t-field="contract.start_date"/>
                                </td>
                                <td>
                                    <span t-field="contract.end_date"/>
                                </td>
                                <td>
                                    <span t-field="contract.state"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div t-if="not contracts"
                     class="alert alert-info">
                    No service contracts are currently available.
                </div>
            </div>
        </t>
    </template>

    <template id="portal_binaryguard_tickets"
              name="My BinaryGuard Tickets">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <h2>My Support Tickets</h2>

                <div class="table-responsive mt-3">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Ticket</th>
                                <th>Subject</th>
                                <th>Priority</th>
                                <th>Assigned To</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="tickets" t-as="ticket">
                                <td>
                                    <span t-field="ticket.name"/>
                                </td>
                                <td>
                                    <span t-field="ticket.subject"/>
                                </td>
                                <td>
                                    <span t-field="ticket.priority"/>
                                </td>
                                <td>
                                    <span t-field="ticket.assigned_user_id"/>
                                </td>
                                <td>
                                    <span t-field="ticket.state"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div t-if="not tickets"
                     class="alert alert-info">
                    No support tickets are currently available.
                </div>
            </div>
        </t>
    </template>

    <template id="portal_binaryguard_access_cards"
              name="My BinaryGuard Access Cards">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <h2>My Access Cards</h2>

                <div class="table-responsive mt-3">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Card Number</th>
                                <th>Cardholder</th>
                                <th>Site</th>
                                <th>Access Level</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="access_cards" t-as="card">
                                <td>
                                    <span t-field="card.card_number"/>
                                </td>
                                <td>
                                    <span t-field="card.cardholder_name"/>
                                </td>
                                <td>
                                    <span t-field="card.site_location"/>
                                </td>
                                <td>
                                    <span t-field="card.access_level"/>
                                </td>
                                <td>
                                    <span t-field="card.status"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div t-if="not access_cards"
                     class="alert alert-info">
                    No access-card records are currently available.
                </div>
            </div>
        </t>
    </template>

    <template id="portal_binaryguard_maintenance"
              name="My BinaryGuard Maintenance">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <h2>My Maintenance Plans</h2>

                <div class="table-responsive mt-3">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Plan</th>
                                <th>Type</th>
                                <th>Frequency</th>
                                <th>Next Service</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="maintenance_plans"
                                t-as="plan">
                                <td>
                                    <span t-field="plan.title"/>
                                </td>
                                <td>
                                    <span t-field="plan.maintenance_type"/>
                                </td>
                                <td>
                                    <span t-field="plan.frequency"/>
                                </td>
                                <td>
                                    <span t-field="plan.next_service_date"/>
                                </td>
                                <td>
                                    <span t-field="plan.state"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div t-if="not maintenance_plans"
                     class="alert alert-info">
                    No maintenance plans are currently available.
                </div>
            </div>
        </t>
    </template>

</odoo>

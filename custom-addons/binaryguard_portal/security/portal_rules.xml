<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_portal_binaryguard_assets" model="ir.rule">
        <field name="name">Portal: customer assets only</field>
        <field name="model_id" ref="binaryguard_assets.model_binaryguard_asset"/>
        <field name="domain_force">
            [('customer_id', 'child_of', [user.partner_id.commercial_partner_id.id])]
        </field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>


<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="binaryguard_stock_picking_form"
            model="ir.ui.view">

        <field name="name">stock.picking.binaryguard.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="inside">

                <page string="BinaryGuard">

                    <group>

                        <group>
                            <field name="binaryguard_project"/>
                            <field name="binaryguard_site"/>
                        </group>

                        <group>
                            <field name="binaryguard_installer"/>
                        </group>

                    </group>

                    <group>
                        <field name="binaryguard_notes"/>
                    </group>

                </page>

            </xpath>

        </field>

    </record>

</odoo>

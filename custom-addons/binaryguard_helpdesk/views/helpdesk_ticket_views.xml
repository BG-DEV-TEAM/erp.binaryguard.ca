<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_binaryguard_helpdesk_ticket_list" model="ir.ui.view">
        <field name="name">binaryguard.helpdesk.ticket.list</field>
        <field name="model">binaryguard.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Helpdesk Tickets"
                  decoration-danger="priority == '3' and state not in ('resolved', 'closed')"
                  decoration-warning="priority == '2' and state not in ('resolved', 'closed')"
                  decoration-success="state in ('resolved', 'closed')">
                <field name="name"/>
                <field name="subject"/>
                <field name="customer_id"/>
                <field name="system_type"/>
                <field name="priority" widget="priority"/>
                <field name="assigned_user_id"/>
                <field name="state"/>
                <field name="reported_date"/>
                <field name="scheduled_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_binaryguard_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">binaryguard.helpdesk.ticket.form</field>
        <field name="model">binaryguard.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket">
                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="new,assigned,in_progress,waiting_customer,waiting_parts,scheduled,resolved,closed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="subject"/>
                        <h1>
                            <field name="subject"
                                   placeholder="Brief description of the issue..."/>
                        </h1>
                        <h2>
                            <field name="name" readonly="1"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Customer">
                            <field name="customer_id"/>
                            <field name="contact_id"/>
                            <field name="customer_email"/>
                            <field name="customer_phone"/>
                            <field name="site_location"/>
                        </group>

                        <group string="Assignment">
                            <field name="priority" widget="priority"/>
                            <field name="assigned_user_id"/>
                            <field name="reported_date"/>
                            <field name="scheduled_date"/>
                            <field name="resolved_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Issue Details">
                            <group>
                                <group>
                                    <field name="issue_category"/>
                                    <field name="system_type"/>
                                    <field name="remote_support_required"/>
                                    <field name="site_visit_required"/>
                                </group>

                                <group>
                                    <field name="project_id"/>
                                    <field name="field_service_task_id"/>
                                    <field name="product_id"/>
                                    <field name="serial_number"/>
                                </group>
                            </group>

                            <group string="Description">
                                <field name="description"/>
                            </group>
                        </page>

                        <page string="Technical Work">
                            <group string="Diagnosis">
                                <field name="diagnosis"/>
                            </group>

                            <group string="Resolution">
                                <field name="resolution"/>
                            </group>
                        </page>

                        <page string="Internal Notes">
                            <field name="internal_notes"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_binaryguard_helpdesk_ticket_search" model="ir.ui.view">
        <field name="name">binaryguard.helpdesk.ticket.search</field>
        <field name="model">binaryguard.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="Search Helpdesk Tickets">
                <field name="name"/>
                <field name="subject"/>
                <field name="customer_id"/>
                <field name="assigned_user_id"/>
                <field name="system_type"/>
                <field name="serial_number"/>

                <separator/>

                <filter name="my_tickets"
                        string="My Tickets"
                        domain="[('assigned_user_id', '=', uid)]"/>

                <filter name="open_tickets"
                        string="Open Tickets"
                        domain="[('state', 'not in', ['resolved', 'closed', 'cancelled'])]"/>

                <filter name="critical_tickets"
                        string="Critical"
                        domain="[('priority', '=', '3')]"/>

                <filter name="site_visit_required"
                        string="Site Visit Required"
                        domain="[('site_visit_required', '=', True)]"/>

                <filter name="remote_support_required"
                        string="Remote Support Required"
                        domain="[('remote_support_required', '=', True)]"/>

                <separator/>

                <filter name="group_by_status"
                        string="Status"
                        context="{'group_by': 'state'}"/>

                <filter name="group_by_technician"
                        string="Technician"
                        context="{'group_by': 'assigned_user_id'}"/>

                <filter name="group_by_customer"
                        string="Customer"
                        context="{'group_by': 'customer_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_binaryguard_helpdesk_tickets" model="ir.actions.act_window">
        <field name="name">Helpdesk Tickets</field>
        <field name="res_model">binaryguard.helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_binaryguard_helpdesk_ticket_search"/>
        <field name="context">{'search_default_open_tickets': 1}</field>
    </record>

    <record id="action_binaryguard_helpdesk_my_tickets" model="ir.actions.act_window">
        <field name="name">My Tickets</field>
        <field name="res_model">binaryguard.helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('assigned_user_id', '=', uid)]</field>
        <field name="search_view_id" ref="view_binaryguard_helpdesk_ticket_search"/>
    </record>

</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_sale_order_binaryguard" model="ir.ui.view">
        <field name="name">sale.order.binaryguard</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <page string="BinaryGuard">

                    <group>

                        <field name="binaryguard_project"/>
                        <field name="binaryguard_customer_po"/>
                        <field name="binaryguard_installation_date"/>
                        <field name="binaryguard_assigned_technician"/>
                        <field name="binaryguard_installation_status"/>

                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>

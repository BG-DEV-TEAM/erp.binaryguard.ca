#!/usr/bin/env bash

set -Eeuo pipefail

REPO_DIR="/opt/binaryguard-odoo"
BRANCH="main"
ODOO_SERVICE="odoo.service"
BACKUP_SCRIPT="/usr/local/bin/backup-odoo"

LOG_DIR="/var/log/odoo-deploy"
TIMESTAMP="$(date '+%Y-%m-%d_%H-%M-%S')"
LOG_FILE="$LOG_DIR/deploy-$TIMESTAMP.log"

PREVIOUS_COMMIT=""
NEW_COMMIT=""
DEPLOYMENT_STARTED=false
ROLLBACK_RUNNING=false

mkdir -p "$LOG_DIR"

exec > >(tee -a "$LOG_FILE") 2>&1

rollback() {
    local reason="${1:-Unknown deployment failure}"

    if [[ "$ROLLBACK_RUNNING" == "true" ]]; then
        echo "Rollback is already running."
        return 1
    fi

    ROLLBACK_RUNNING=true

    echo
    echo "========================================"
    echo "ROLLBACK STARTED"
    echo "Reason: $reason"
    echo "Time: $(date -Is)"
    echo "========================================"

    if [[ -z "$PREVIOUS_COMMIT" ]]; then
        echo "ERROR: Previous commit is unknown."
        echo "Automatic Git rollback cannot continue."
        return 1
    fi

    cd "$REPO_DIR"

    echo "Restoring commit: $PREVIOUS_COMMIT"
    git reset --hard "$PREVIOUS_COMMIT"

    echo "Restarting Odoo using previous code..."
    systemctl restart "$ODOO_SERVICE"

    sleep 8

    if ! systemctl is-active --quiet "$ODOO_SERVICE"; then
        echo "CRITICAL: Odoo did not start after rollback."
        systemctl status "$ODOO_SERVICE" --no-pager -l || true
        journalctl -u "$ODOO_SERVICE" -n 100 --no-pager || true
        return 1
    fi

    local rollback_http_code

    rollback_http_code="$(curl \
        --silent \
        --output /dev/null \
        --write-out "%{http_code}" \
        --max-time 15 \
        http://127.0.0.1:8069 || true)"

    if [[ "$rollback_http_code" =~ ^(200|302|303)$ ]]; then
        echo "Rollback health check passed: HTTP $rollback_http_code"
        echo "Rollback completed successfully."
        return 0
    fi

    echo "CRITICAL: Rollback HTTP health check failed."
    echo "HTTP status: ${rollback_http_code:-no response}"
    return 1
}

deployment_error_handler() {
    local exit_code=$?
    local line_number=$1

    echo
    echo "ERROR: Deployment command failed."
    echo "Line: $line_number"
    echo "Exit code: $exit_code"

    if [[ "$DEPLOYMENT_STARTED" == "true" ]]; then
        rollback "Command failure at line $line_number"
    fi

    exit "$exit_code"
}

trap 'deployment_error_handler $LINENO' ERR

echo "========================================"
echo "BinaryGuard Odoo Deployment"
echo "Started: $(date -Is)"
echo "Log: $LOG_FILE"
echo "========================================"

echo
echo "Step 1: Creating pre-deployment backup..."

if [[ ! -x "$BACKUP_SCRIPT" ]]; then
    echo "ERROR: Backup script is missing or not executable:"
    echo "$BACKUP_SCRIPT"
    exit 1
fi

"$BACKUP_SCRIPT"

echo "Backup completed successfully."

echo
echo "Step 2: Fetching latest GitHub code..."

cd "$REPO_DIR"

git fetch origin "$BRANCH"

PREVIOUS_COMMIT="$(git rev-parse HEAD)"
NEW_COMMIT="$(git rev-parse "origin/$BRANCH")"

echo "Previous commit: $PREVIOUS_COMMIT"
echo "Target commit:   $NEW_COMMIT"

if [[ "$PREVIOUS_COMMIT" == "$NEW_COMMIT" ]]; then
    echo "Repository is already up to date."
else
    echo "Applying target commit..."
    DEPLOYMENT_STARTED=true
    git reset --hard "$NEW_COMMIT"
fi

echo
echo "Step 3: Restarting Odoo..."

DEPLOYMENT_STARTED=true
systemctl restart "$ODOO_SERVICE"

echo
echo "Step 4: Waiting for Odoo to start..."

SERVICE_HEALTHY=false

for attempt in {1..6}; do
    echo "Service check attempt $attempt of 6..."

    if systemctl is-active --quiet "$ODOO_SERVICE"; then
        SERVICE_HEALTHY=true
        break
    fi

    sleep 5
done

if [[ "$SERVICE_HEALTHY" != "true" ]]; then
    echo "ERROR: Odoo service failed to become active."
    systemctl status "$ODOO_SERVICE" --no-pager -l || true
    journalctl -u "$ODOO_SERVICE" -n 100 --no-pager || true

    rollback "Odoo service health check failed"
    exit 1
fi

echo "Odoo service is active."

echo
echo "Step 5: Checking Odoo HTTP endpoint..."

HTTP_HEALTHY=false
HTTP_CODE=""

for attempt in {1..6}; do
    echo "HTTP check attempt $attempt of 6..."

    HTTP_CODE="$(curl \
        --silent \
        --output /dev/null \
        --write-out "%{http_code}" \
        --max-time 15 \
        http://127.0.0.1:8069 || true)"

    if [[ "$HTTP_CODE" =~ ^(200|302|303)$ ]]; then
        HTTP_HEALTHY=true
        break
    fi

    echo "Current HTTP result: ${HTTP_CODE:-no response}"
    sleep 5
done

if [[ "$HTTP_HEALTHY" != "true" ]]; then
    echo "ERROR: Odoo HTTP health check failed."
    echo "Final HTTP result: ${HTTP_CODE:-no response}"

    rollback "Odoo HTTP health check failed"
    exit 1
fi

echo "HTTP health check passed: HTTP $HTTP_CODE"

echo
echo "Step 6: Recording successful deployment..."

echo "$NEW_COMMIT" > "$REPO_DIR/.last-successful-commit"

find "$LOG_DIR" \
    -type f \
    -name "deploy-*.log" \
    -mtime +30 \
    -delete

echo
echo "========================================"
echo "Deployment completed successfully."
echo "Previous commit: $PREVIOUS_COMMIT"
echo "Current commit:  $(git rev-parse HEAD)"
echo "Completed: $(date -Is)"
echo "Log: $LOG_FILE"
echo "========================================"

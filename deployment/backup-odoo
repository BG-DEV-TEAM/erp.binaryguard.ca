#!/bin/bash

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_DIR="/opt/backups/odoo/$TIMESTAMP"

mkdir -p "$BACKUP_DIR"

echo "Creating backup..."

# Backup Odoo configuration
cp /etc/odoo.conf "$BACKUP_DIR/"

# Backup custom addons
tar -czf "$BACKUP_DIR/custom-addons.tar.gz" \
    -C /opt/binaryguard-odoo custom-addons

# Backup PostgreSQL database
sudo -u postgres pg_dump binaryguard_odoo > "$BACKUP_DIR/database.sql"

# Remove backups older than 30 days
find /opt/backups/odoo -mindepth 1 -maxdepth 1 -type d -mtime +30 -exec rm -rf {} \;

echo "Backup completed: $BACKUP_DIR"
